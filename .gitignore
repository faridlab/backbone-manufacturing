# Rust
/target
**/*.rs.bk
*.pdb

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
.claude/
# graphify knowledge graph (local, not committed)
graphify-out/

# Future-proofing only: this repository has NO .cargo/ directory — the committed Cargo.lock is
# truthful (`cargo metadata --locked` exits 0 on the clean tree) and no local patch override
# exists. Should a local override ever be needed again, it must live in an ignored file like
# these so the committed lock never silently diverges from what actually builds.
.cargo/config.toml
.cargo/config.toml.quarantined
